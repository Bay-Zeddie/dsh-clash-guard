{
  "_comment": "dsh-clash-guard 默认配置。所有可调值集中在这里，代码里不出现字面量。settings.json 里的同名键覆盖本文件；环境变量 DSH_CLASH_GUARD_<PATH> 再覆盖一层（__ 分隔层级）。",
  "controller": {
    "pipeName": "",
    "controllerUrl": "",
    "secret": "",
    "requestTimeoutMs": 8000,
    "defaultHost": "127.0.0.1"
  },
  "ports": {
    "mixedPort": 0,
    "fallbackMixedPort": 0
  },
  "leaks": {
    "_comment": "泄漏探针参数。目的是把「是不是真的暴露」拆成可判定的独立事实，而不是看开关脸色。",
    "dnsProbeName": "www.gstatic.com",
    "dnsProbeType": "A",
    "dnsProbeTimeoutMs": 5000,
    "fakeIpRange": "198.18.0.0/15",
    "interfaceProbe": {
      "host": "1.1.1.1",
      "port": 80,
      "timeoutMs": 2500
    },
    "ipv6Probe": {
      "host": "2606:4700:4700::1111",
      "port": 80,
      "timeoutMs": 2500
    },
    "multiSource": {
      "enabled": true,
      "minAnswers": 2
    },
    "killSwitch": {
      "enabled": false,
      "_enabledComment": "检测到泄漏时自动切到安全档。默认关：自动动作会打断正在跑的扫描，得由用户显式打开。",
      "onLeak": "global",
      "cooldownMs": 60000
    }
  },
  "harden": {
    "strictRoute": true,
    "systemProxy": true,
    "winHttpProxy": true,
    "disableIpv6": true,
    "pointDns": true,
    "disableAutoDoh": true,
    "closeConnections": true,
    "blockInterfaceEgress": false,
    "_blockInterfaceEgressComment": "接口级出站封锁（防火墙）。默认关闭：实测会连带封死 mihomo 自己的出站（Windows 防火墙 Block 优先于 Allow，且 mihomo 与直连程序共用同一个源地址，无法按进程区分）。开启前请确认你接受「代理可能断」的后果。",
    "raiseRouteMetric": false,
    "_raiseRouteMetricComment": "抬高物理网卡 metric。实测对绑卡流量无效（Windows 的 bind 无视 metric），默认关。",
    "physicalRouteMetric": 9000
  },
  "firewall": {
    "_comment": "接口级出站封锁的规则名。固定前缀，撤销时按前缀精确删除，绝不碰用户自己的规则。",
    "rulePrefix": "dsh-clash-guard/",
    "blockSuffix": "block-physical-egress",
    "allowSuffix": "allow-core-egress"
  },
  "tun": {
    "enable": true,
    "autoRoute": true,
    "autoDetectInterface": true,
    "stack": ""
  },
  "dns": {
    "enable": true,
    "enhancedMode": "fake-ip",
    "hijack": [
      "any:53"
    ]
  },
  "egress": {
    "endpoints": [
      "https://api.ipify.org",
      "https://ifconfig.me/ip",
      "https://icanhazip.com"
    ],
    "timeoutMs": 12000,
    "boundTimeoutMs": 3000,
    "_boundTimeoutComment": "绑卡探测的超时。它是最容易不通的一条（TUN 会拦死），没必要等满 12 秒；3 秒足够判定「这条路被堵住了」。",
    "userAgent": "dsh-clash-guard",
    "proxyHost": "127.0.0.1"
  },
  "bypass": {
    "loopback": [
      "localhost",
      "127.*",
      "<local>"
    ],
    "terminalNames": [
      "DIRECT",
      "REJECT"
    ],
    "selectorGroup": "GLOBAL",
    "infoNodePatterns": [
      "剩余流量",
      "套餐到期",
      "过期",
      "官网",
      "订阅",
      "流量重置",
      "expire",
      "traffic",
      "重置"
    ],
    "_infoNodeComment": "机场信息节点（显示订阅余额/到期的假节点）不能出现在可切换列表里：切到它等于断网。"
  },
  "discovery": {
    "appDirPatterns": [
      "clash-verge",
      "clashverge"
    ],
    "serviceDirPatterns": [
      "clash-verge-service",
      "clashverge-service"
    ],
    "coreNames": [
      "verge-mihomo",
      "mihomo",
      "clash-meta",
      "clash"
    ],
    "pipePrefixes": [
      "verge-mihomo-",
      "mihomo-",
      "clash-"
    ],
    "configFileNames": [
      "clash-verge.yaml",
      "config.yaml",
      "verge.yaml"
    ],
    "runtimeConfigName": "config.yaml",
    "runtimeUsersDir": "users",
    "runtimeSubdir": "runtime",
    "desiredStateFileName": "desired-state.json",
    "processQueryTimeoutMs": 8000,
    "tunAdapterPatterns": [
      "mihomo",
      "clash",
      "meta",
      "tun",
      "wintun"
    ],
    "virtualAdapterPatterns": [
      "vmware",
      "virtualbox",
      "hyper-v",
      "vethernet",
      "loopback",
      "bluetooth"
    ]
  },
  "windows": {
    "powershell": "powershell.exe",
    "powershellFlags": [
      "-NoProfile",
      "-NonInteractive",
      "-ExecutionPolicy",
      "Bypass",
      "-Command"
    ],
    "internetSettingsKey": "HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Internet Settings",
    "autoDohKey": "HKLM:\\SYSTEM\\CurrentControlSet\\Services\\Dnscache\\Parameters",
    "autoDohValue": "EnableAutoDoh",
    "ipv6ComponentId": "ms_tcpip6",
    "wininetRefreshFlags": [
      39,
      37
    ],
    "defaultRoutePrefix": "0.0.0.0/0",
    "netshShowProxy": "netsh winhttp show proxy",
    "netshSetProxy": "netsh winhttp set proxy",
    "netshResetProxy": "netsh winhttp reset proxy",
    "directAccessPatterns": [
      "Direct access",
      "直接访问"
    ],
    "tunDnsSuffix": ".2",
    "commandTimeoutMs": 20000,
    "maxBufferBytes": 4194304
  },
  "audit": {
    "severities": {
      "mode": "critical",
      "tun": "critical",
      "auto-route": "critical",
      "dns-fakeip": "critical",
      "dns-hijack": "critical",
      "controller-secret": "medium",
      "global-selector": "critical",
      "live-direct": "critical",
      "egress": "critical",
      "egress-vs-real": "critical",
      "strict-route": "high",
      "auto-doh": "high",
      "ipv6": "high",
      "system-proxy": "medium",
      "dns-resolver": "medium",
      "winhttp": "low",
      "process-direct": "critical",
      "interface-bypass": "critical",
      "default-routes": "critical",
      "machine-traffic": "critical",
      "system-resolver": "high"
    },
    "blockingSeverities": [
      "critical",
      "high"
    ]
  },
  "http": {
    "prefix": "/dsh-clash-guard",
    "maxBodyBytes": 16384,
    "routes": {
      "state": "/state",
      "mode": "/mode",
      "verify": "/verify",
      "nodes": "/nodes",
      "calibrate": "/calibrate",
      "settings": "/settings",
      "i18n": "/i18n",
      "kernel": "/kernel",
      "ip": "/ip",
      "net": "/net"
    }
  },
  "locale": {
    "file": "locale/strings.json",
    "fallback": "zh",
    "defaultLocale": "zh"
  },
  "ui": {
    "panelSlot": "sidebar.panellist",
    "panelId": "dsh-clash-guard",
    "panelOrder": 24,
    "panelLabelZh": "代理守卫",
    "panelLabelEn": "Proxy Guard",
    "enablePill": false,
    "_enablePillComment": "输入框旁的三段式小开关。默认关闭：唯一入口是侧边栏「代理守卫」，避免同一功能出现两个入口。想加回来就置 true。",
    "enableIndicator": true,
    "_enableIndicatorComment": "输入框旁的 IP 指示灯：一个圆点 + 一行文案，和「AI 控制电脑」同一个座位、同一套视觉。它只显示与检查，不切换模式。",
    "indicatorSlot": "conversation.input.left",
    "indicatorId": "clash-guard-ip-indicator",
    "indicatorOrder": 25,
    "indicatorPollMs": 30000,
    "_indicatorPollComment": "指示灯多久自己复查一次出口 IP。太频繁会持续打代理出口，30s 是折中。",
    "indicatorProbeOnMount": true,
    "pillSlot": "conversation.input.left",
    "pillId": "clash-guard-mode",
    "pillOrder": 26,
    "settingsSlot": "settings.section",
    "settingsId": "clash-guard",
    "settingsOrder": 64,
    "nodeListLimit": 60,
    "nodeListMaxLimit": 400,
    "statePollMs": 15000,
    "styleId": "dsh-clash-guard-style",
    "localeRoute": "i18n",
    "retryDelayMs": 400,
    "maxAttempts": 8,
    "maxContentWidth": 960,
    "topClearanceVar": "--dsh-frame-top-clearance"
  },
  "tools": {
    "status": "clash_status",
    "mode": "clash_mode",
    "verify": "clash_verify",
    "nodes": "clash_nodes",
    "calibrate": "clash_calibrate"
  },
  "modes": {
    "global": "global",
    "rule": "rule",
    "off": "direct"
  },
  "verge": {
    "modeKey": "mode",
    "backupSuffix": ".clash-guard.bak",
    "tempSuffix": ".clash-guard.tmp",
    "writeRuntimeConfig": true,
    "_writeRuntimeComment": "必须双写：runtime/config.yaml 是服务重启内核时直接读的那份，只写 clash-verge.yaml 会在内核重启后回退。"
  },
  "selfheal": {
    "_comment": "网络自愈。防的是这个真实事故：Clash 非正常退出后物理网卡 DNS 停在 198.18.0.2（TUN 网关），内核已死 → 整机域名解析全部超时。2026-11-18 连续两次复发，靠人记着「正常退出」不管用。",
    "watchdog": true,
    "_watchdogComment": "后台守护：定时体检，发现「DNS 指向死隧道地址」或「系统代理指向死端口」就自动修复。关掉就只能靠手动点「修复网络」。",
    "watchdogMs": 15000,
    "_watchdogMsComment": "体检间隔。15 秒足够快（用户还没察觉就修好了），又不至于频繁跑 PowerShell。",
    "healOnStart": true,
    "_healOnStartComment": "插件加载时先体检一次。进程刚起时最容易撞上上次的残留。"
  },
  "core": {
    "_comment": "内核生命周期。内核由 Windows 服务守护（开机自启），GUI 只是前端；插件可完全脱离 GUI 控制。",
    "serviceName": "clash_verge_service",
    "coreProcessNames": [
      "verge-mihomo",
      "mihomo",
      "clash-meta"
    ],
    "guiProcessNames": [
      "clash-verge"
    ],
    "startTimeoutMs": 20000,
    "stopTimeoutMs": 12000,
    "pollIntervalMs": 500,
    "autoStartOnGlobal": true,
    "_autoStartComment": "切到全局时如果内核没起，自动通过服务拉起 —— 否则「开了全局」只是一句空话。",
    "autoRestartAfterPersist": false,
    "_autoRestartComment": "写入配置后是否重启内核使其立刻生效。默认 false：PATCH 已经即时生效，重启只在需要重读整份配置文件时才必要。",
    "allowDirectSpawn": false,
    "_allowDirectSpawnComment": "允许插件绕过服务直接 spawn 内核。默认 false，别开。2026-11-18 事故：插件 spawn 的内核成了孤儿进程（PID 11480），Clash 之后启动时服务报「refusing a second core」拒绝起核，而 DNS 已被改成 198.18.0.2 → 整机断网。内核是服务的孩子，不能由插件收养。"
  },
  "glass": {
    "_comment": "磨砂配方。与 dsh-sunfragment-skin 逐字对齐：单档薄磨砂，全站一个数值。优先读官方令牌 --dsw-menu-backdrop-filter（皮肤装了就跟皮肤走），缺失时用同一份兜底值。",
    "token": "--dsw-menu-backdrop-filter",
    "fallback": "blur(10px) saturate(160%) brightness(.82)",
    "blur": 10,
    "saturate": 160,
    "brightness": 0.82,
    "surfaceAlpha": 0
  }
}
